# Read `man 5 sway` for a complete reference.

### Variables
set $alt Mod1
set $mod Mod4
set $secondary Shift

set $config_root ~/Documents/Config/Dotfiles/src

set $menu wofi -i --show drun | xargs swaymsg exec --



exec waybar -c $config_root/waybar/sway/waybar_sway.jsonc -s $config_root/waybar/sway/style.css &



### Appearance
client.focused #FF4151 #FF4151 #ffffff
client.unfocused #E5E9F0 #E5E9F0 #888888
client.urgent #BF616A #900000 #ffffff




default_border pixel 1
hide_edge_borders both
gaps {
    outer 0
    inner -1
}



### Output configuration
# man 5 sway-output
output eDP-1 {
    background $config_root/hypr/backgroundFish.jpg fill #0F111A
    resolution 2880x1800@90.001Hz
    scale 1
    # This is the correct one
    subpixel vrgb
    adaptive_sync on
    render_bit_depth 10
}
# You can get the names of your outputs by running: swaymsg -t get_outputs



### Idle configuration
#
# Example configuration:
#
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.



### Input configuration
input "1267:12729:ASUE140D:00_04F3:31B9_Touchpad" {
    accel_profile flat
    pointer_accel 1.0
    click_method clickfinger
    drag enabled
    dwt enabled # disable while typing
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}



### Key bindings
bindsym $mod+q exec kitty



# Kill focused window
bindsym $alt+f4 kill



# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal



# Reload the configuration file
bindsym $mod+Shift+c reload






include /etc/sway/config.d/*
include ./sway_keybindings.conf
include ./sway_workspaces.conf



set $win_float "(kitty|qalculate|blueberry.py|nm-connection-editor|pavucontrol|org.gnome.clocks|gnome-system-monitor|org.kde.polkit-kde-authentication-agent-1)"
set $win_opacity "(kitty|qalculate|blueberry.py|nm-connection-editor|pavucontrol|org.gnome.clocks|gnome-system-monitor)"
set $win_center_cursor "(kitty|qalculate|org.kde.polkit-kde-authentication-agent-1)"
set $win_big "(blueberry.py|nm-connection-editor|pavucontrol|gnome-system-monitor)"
set $win_medium "(kitty|qalculate|org.gnome.clocks)"
set $win_small "(org.kde.polkit-kde-authentication-agent-1)"

for_window [app_id=$win_float] floating enable

for_window [app_id=$win_big] resize set 1440 900
for_window [app_id=$win_medium] resize set 960 600
for_window [app_id=$win_small] resize set 576 360

for_window [app_id=$win_center_cursor] move position cursor